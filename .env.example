# Copy this file to .env.local and fill in real values.

# Telegram bot that receives contact-form leads and newsletter signups.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_LEADS=
TELEGRAM_TOPIC_NEWSLETTER=

# Google Apps Script web app URL that appends leads to a spreadsheet.
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_SECRET=

# Upstash Redis — used to rate-limit /api/contact (5 requests / 10 min / IP).
# Create a free database at https://console.upstash.com, then copy its
# "REST API" URL and token here. Without these, rate limiting is skipped
# (a warning is logged) rather than the form breaking.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
